# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

**/.DS_Store
# Ignore bundler config.
/.bundle

# Ignore all environment files (except templates).
/.env*
!/.env*.erb

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets
# Ignore master key for decrypting credentials and more.
/config/master.key

/app/assets/builds/*
!/app/assets/builds/.keep
/lib/activeagent
/lib/activeagent/*
lib/activeagent/activeagent.gemspec
lib/activeagent/README.md
lib/activeagent/lib/active_agent.rb
lib/activeagent/lib/active_agent/action_prompt.rb
lib/activeagent/lib/active_agent/base.rb
lib/activeagent/lib/active_agent/callbacks.rb
lib/activeagent/lib/active_agent/core.rb
lib/activeagent/lib/active_agent/generation_job.rb
lib/activeagent/lib/active_agent/generation_provider.rb
lib/activeagent/lib/active_agent/generation.rb
lib/activeagent/lib/active_agent/operation.rb
lib/activeagent/lib/active_agent/parameterized.rb
lib/activeagent/lib/active_agent/queued_generation
lib/activeagent/lib/active_agent/queued_generation.rb
lib/activeagent/lib/active_agent/service.rb
lib/activeagent/lib/active_agent/version.rb
lib/activeagent/lib/active_agent/generation_provider/base.rb
lib/activeagent/lib/active_agent/generation_provider/open_ai_provider.rb
lib/activeagent/lib/active_agent/generation_provider/response.rb
