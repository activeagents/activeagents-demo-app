<%= turbo_frame_tag "#{dom_id(chat)}_message_form", class: "fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 p-4" do %>
  <%= form_with(model: Message.new, url: [chat, chat.messages.new], class: "flex items-end gap-3") do |form| %>
    <%= form.text_area :content, 
        rows: 1, 
        class: "flex-1 shadow rounded-md border border-gray-200 outline-none px-3 py-2 resize-none", 
        placeholder: "Type a message...",
        autofocus: true %>
    
    <%= form.button type: :submit, class: "rounded-lg py-2 px-4 bg-blue-600 text-white font-medium cursor-pointer hover:bg-blue-700 transition-colors" do %>
      <i class="fas fa-paper-plane"></i>
      <span class="pl-2">Send</span>
    <% end %>
  <% end %>
<% end %>