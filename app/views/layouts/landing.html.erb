<!DOCTYPE html>
<html lang="en" class="theme-dark">

<head>
  <meta charset="utf-8" />
  <title>Active Agent - AI Agent Framework for Rails</title>
  <meta content="Build AI-powered agents for your Rails applications with Active Agent - the Ruby framework for intelligent automation" name="description" />
  <meta content="width=device-width, initial-scale=1" name="viewport" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Active Agent" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:title" content="Active Agent - AI Agent Framework for Rails" />
  <meta property="og:description" content="Build AI-powered agents for your Rails applications" />
  <meta property="og:url" content="https://activeagents.ai" />
  <meta name="twitter:site" content="@activeagents" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Active Agent - AI Agent Framework for Rails" />
  <meta name="twitter:description" content="Build AI-powered agents for your Rails applications" />

  <!-- Favicon and icons -->
  <link rel="icon" href="/landing/images/favicon/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/landing/images/favicon/icon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/landing/images/favicon/apple-touch-icon.png" />

  <!-- Preload fonts -->
  <link rel="preload" href="/landing/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin />

  <!-- Styles -->
  <link href="/landing/vendor/font-awesome-6.7.2/css/all.min.css" rel="stylesheet" />
  <link href="/landing/css/index.css" rel="stylesheet" type="text/css" />
  <link href="/landing/css/pricing.css" rel="stylesheet" type="text/css" />
  <link href="/landing/css/tablet.css" rel="stylesheet" type="text/css" />
  <link href="/landing/css/mobile.css" rel="stylesheet" type="text/css" />
  <script src="/landing/js/main.js" type="text/javascript" defer></script>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
</head>

<body>
  <div class="background-gradient"></div>
  <div class="page-container">
    <header class="nav-container">
      <a href="/" class="nav-brand">
        <span style="font-size: 1.5rem; font-weight: 700; color: var(--color-accent);">Active Agent</span>
      </a>
      <nav role="navigation" class="nav-menu" data-navigation>
        <a href="#pricing" class="nav-link">Pricing</a>
        <a href="https://github.com/activeagents/activeagent" class="nav-link">Docs</a>
        <a href="https://github.com/activeagents/activeagent" class="nav-link">GitHub</a>
        <div class="button-group stacked margin-top-l mobile-only">
          <a href="/dashboard" class="button tertiary">Sign In</a>
          <a href="/dashboard" class="button primary">Get Started</a>
        </div>
      </nav>
      <div class="button-group">
        <a href="https://github.com/activeagents/activeagent" class="button ghost compact hide-on-mobile">
          <div class="fa-brands fa-github icon l"></div>
        </a>
        <a href="/dashboard" class="button tertiary compact hide-on-mobile">Sign In</a>
        <a href="/dashboard" class="button primary compact">Get Started</a>
        <button class="button ghost compact nav-hamburger" data-mobile-toggle aria-label="Show menu">
          <span class="fa-solid fa-bars icon m"></span>
        </button>
      </div>
    </header>
    <main>
      <%= yield %>
    </main>
    <footer class="footer">
      <div class="footer-menu">
        <div>
          <p class="paragraph s">
            &copy; <%= Date.current.year %> Active Agent<br />
            Built with Ruby on Rails
          </p>
        </div>
        <div>
          <div class="link-list">
            <a href="#pricing" class="ui s">Pricing</a>
            <a href="https://github.com/activeagents/activeagent" class="ui s" target="_blank">Documentation</a>
            <a href="https://github.com/activeagents/activeagent" class="ui s" target="_blank">GitHub</a>
          </div>
        </div>
        <div>
          <div class="link-list">
            <a href="https://github.com/activeagents/activeagent" class="icon-link ui s" target="_blank">
              <div class="fa-brands fa-github icon m color-accent"></div>
              <div class="pseudo-link">GitHub</div>
            </a>
            <a href="https://x.com/activeagents" class="icon-link ui s" target="_blank">
              <div class="fa-brands fa-x-twitter icon m color-accent"></div>
              <div class="pseudo-link">X.com</div>
            </a>
          </div>
        </div>
      </div>
      <div class="link-list-horizontal">
        <a href="#" class="ui s tertiary">Privacy Policy</a>
        <a href="#" class="ui s tertiary">Terms of Service</a>
      </div>
    </footer>
  </div>
</body>

</html>
