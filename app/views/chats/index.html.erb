<div class="w-full">
  <% if notice.present? %>
    <p class="inline-block px-3 py-2 mb-5 font-medium text-green-500 rounded-lg bg-green-50" id="notice"><%= notice %></p>
  <% end %>

  <% content_for :title, "Chats" %>

  <div class="flex items-center justify-between">
    <h1 class="text-4xl font-bold">Chats</h1>
    <%= link_to "New chat", new_chat_path, class: "rounded-md py-2 px-3 bg-blue-600 text-white block font-medium" %>
  </div>

  <div id="chats" class="min-w-full">
    <% @chats.each do |chat| %>
      <%= render chat %>
    <% end %>
  </div>
</div>
