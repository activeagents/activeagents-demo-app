<div id="<%= dom_id(translation.message) %>_messages" class="p-3 mt-2 border-l-4 border-blue-400 rounded bg-blue-50">
  <div class="flex items-center justify-between mb-2">
    <span class="text-sm font-medium text-blue-800">Translation</span>
    <span class="px-2 py-1 text-xs rounded-full <%= translation.status == 'completed' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>">
      <%= translation.status.humanize %>
    </span>
  </div>
  <div class="text-gray-700">
    <%= translation.content %>
  </div>
</div>