<%= turbo_stream.update "#{dom_id(@message)}_messages" do %>
  <div class="p-4 m-8 bg-gray-200 rounded-lg">
    <% if @message.content.length > 5000 %>
      <%= image_tag @message.content.to_s %>
    <% else %>
      <%= @message.content %>
    <% end %>
    <div class="mt-2">
      <span class="px-3 py-1 text-sm text-white bg-yellow-500 rounded">
        Translation in progress...
      </span>
    </div>
  </div>
<% end %>